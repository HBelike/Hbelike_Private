{
  "manifest_version": 3,
  "name": "Find Job 求职浏览器助手",
  "version": "0.7.1",
  "description": "读取 BOSS 职位与会话，并通过猎聘官方授权搜索岗位；前程无忧接入待授权。",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://open-agent.liepin.com/*",
    "https://www.xiaohongshu.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://xingxingtech.cn/*",
    "https://www.xingxingtech.cn/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://xingxingtech.cn/*",
        "https://www.xingxingtech.cn/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "识别当前线上笔试题目"
  }
}
