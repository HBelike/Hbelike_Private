# 此文件只提供变量名和示例，不要提交真实密钥；复制为 .env.production 后填写。

# 仅 Nginx Web 容器需要发布到宿主机。生产推荐保持 127.0.0.1，再由 Caddy/Nginx 提供 HTTPS。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# PostgreSQL：请替换为长随机密码。数据库不会暴露宿主机端口。
CAREER_POSTGRES_DB=career_assistant
CAREER_POSTGRES_USER=career_assistant
CAREER_POSTGRES_PASSWORD=replace-with-a-long-random-password

# 生产环境默认脱敏；附件原件只保存在 API 容器 tmpfs，Turn 结束后也会删除。
CAREER_REDACTION_ENABLED=true

# 无 GPU 服务器先保持 false。若启用 document-processing profile，请改为 true。
CAREER_DOCLING_ENABLED=false
DOCLING_SERVE_WORKERS=1
DOCLING_SERVE_MAX_NUM_PAGES=90
DOCLING_SERVE_MAX_FILE_SIZE=10485760

# Gotenberg 用于旧版 DOC/XLS 转 PDF；关闭时旧版 Office 文件会得到明确提示。
CAREER_GOTENBERG_ENABLED=true

# 平台固定图片理解能力：填入阿里云百炼的 API Key 与工作空间 OpenAI-compatible Host。
# 该模型不出现在聊天模型下拉框，也不会被返回给浏览器。
CAREER_DOCUMENT_VISION_API_KEY=
CAREER_DOCUMENT_VISION_BASE_URL=

# 可选：默认模型网关凭证。通过页面保存的模型连接会优先使用其自身保存的 Key。
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MODELSCOPE_API_KEY=
BAIDU_QIANFAN_API_KEY=
HUNYUAN_API_KEY=
DASHSCOPE_API_KEY=
NVIDIA_API_KEY=
TOKENHUB_API_KEY=
SILICONFLOW_API_KEY=
ZHIPUAI_API_KEY=
MINIMAX_API_KEY=
VOLCENGINE_ARK_API_KEY=
