# 求职助手本机开发 PostgreSQL。复制为 .env.career-assistant 后再按需修改。
CAREER_POSTGRES_DB=career_assistant
CAREER_POSTGRES_USER=career_assistant
CAREER_POSTGRES_PASSWORD=change-me-before-production
CAREER_POSTGRES_PORT=54329
CAREER_DATABASE_URL=postgresql+psycopg://career_assistant:change-me-before-production@127.0.0.1:54329/career_assistant

# 用于加密页面保存的模型 API Key。生产环境请使用长随机字符串，并单独安全保管；
# 丢失后，已加密的 Key 无法恢复，需要重新填写。
CAREER_CREDENTIAL_MASTER_KEY=replace-with-a-long-random-secret

# 平台登录邮箱验证码。注册 Resend 并验证发件域名后填写；绝不放到前端或提交进 Git。
# PLATFORM_EMAIL_CODE_SECRET 用于 HMAC 化六位验证码，建议使用至少 32 字节的随机字符串。
PLATFORM_EMAIL_CODE_SECRET=replace-with-another-long-random-secret
RESEND_API_KEY=
RESEND_FROM_ADDRESS=职业智能工作台 <no-reply@your-verified-domain.example>

# 兼容早期环境变量配置的免费额度 Provider。新的模型连接也可直接在页面填写 API Key，
# 系统会用上方主密钥加密后保存到 PostgreSQL。
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MODELSCOPE_API_KEY=
BAIDU_QIANFAN_API_KEY=
HUNYUAN_API_KEY=
DASHSCOPE_API_KEY=
NVIDIA_API_KEY=
TOKENHUB_API_KEY=
SILICONFLOW_API_KEY=
ZHIPUAI_API_KEY=
MINIMAX_API_KEY=
VOLCENGINE_ARK_API_KEY=

# 可选：Docling 文档解析服务启用 X-Api-Key 鉴权时才需要。
# 同时需在 config/career_assistant.yaml 中填入相同的环境变量名并启用服务。
CAREER_DOCLING_API_KEY=

# 独立 Docling 服务的本机资源配置。GPU 服务默认只并发一个解析任务，避免和日常使用抢显存。
DOCLING_SERVE_PORT=5001
DOCLING_SERVE_WORKERS=1
DOCLING_SERVE_MAX_NUM_PAGES=90
DOCLING_SERVE_MAX_FILE_SIZE=10485760
